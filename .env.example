# ===================================================================
# SMART PLACEMENT PORTAL — UNIFIED DOCKER COMPOSE CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# Backend Service Configuration
# -------------------------------------------------------------------
# Exposed port on the host machine
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Inside Docker Compose network, defaults to: mongodb://mongodb:27017/smart_placement_portal
# When running backend locally outside Docker: mongodb://localhost:27017/smart_placement_portal
MONGODB_URI=mongodb://mongodb:27017/smart_placement_portal

# JWT Authentication Secret Key (Replace with a secure random string in production)
JWT_SECRET=super_secret_jwt_key_smart_placement_2026_dev

# Google Gemini API Key (Optional)
# Obtain from Google AI Studio: https://aistudio.google.com/
# If left unset, deterministic fallback answers and evaluations are used.
GEMINI_API_KEY=

# Gemini Live Voice Configuration
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Permitted Client Origin for CORS and WebSockets
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------------
# Redis In-Memory Cache Configuration (Tier-1 Acceleration Layer)
# -------------------------------------------------------------------
# Inside Docker Compose network: redis://redis:6379
# When running backend locally outside Docker: redis://127.0.0.1:6379
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
# Optional: Set password and username if using secured/cloud Redis (Upstash, Redis Cloud, AWS ElastiCache)
REDIS_PASSWORD=
REDIS_USERNAME=
# Set REDIS_TLS=true for secure TLS/SSL connections (or use rediss:// in REDIS_URL)
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
# Increment to instantly invalidate all cached AI prompts and models (e.g. v2, v3)
AI_CACHE_VERSION=v1

# -------------------------------------------------------------------
# Frontend Service Configuration
# -------------------------------------------------------------------
# Target URL for Vite reverse proxy (inside Docker Compose network)
VITE_PROXY_TARGET=http://backend:5000

# Direct API URL override (leave empty to use Vite proxy /api)
VITE_API_URL=
