# ===================================================================
# SMART PLACEMENT PORTAL — ENVIRONMENT CONFIGURATION
# ===================================================================

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String
# Optional: If MongoDB is not running locally, the server activates a resilient
# in-memory store with pre-seeded test data for instant evaluation.
MONGODB_URI=mongodb://localhost:27017/smart_placement_portal

# JWT Authentication Secret Key
# Replace with any strong random string for production
JWT_SECRET=super_secret_jwt_key_smart_placement_2026_dev

# Google Gemini API Key (Optional)
# Get your free key at: https://aistudio.google.com/
# If left empty, text interviews use the deterministic fallback and live voice is disabled.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live voice model and prebuilt interviewer voice
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Frontend Client URL (Deployed on Vercel)
CLIENT_URL=https://smartplacementportal.vercel.app
